$PBExportHeader$m_main.srm
forward
global type m_main from menu
end type
type m_file from menu within m_main
end type
type m_save from menu within m_file
end type
type m_reset from menu within m_file
end type
type m_exit from menu within m_file
end type
type m_edit from menu within m_main
end type
type m_name from menu within m_edit
end type
type m_about from menu within m_edit
end type
end forward
global type m_main from menu
m_file m_file
m_edit m_edit
end type
global m_main m_main
on m_main.create
this.m_file=create m_file
this.m_edit=create m_edit
this.Item[]={this.m_file,this.m_edit}
end on
on m_main.destroy
destroy(this.m_file)
destroy(this.m_edit)
end on
type m_file from menu within m_main
string text = "文件(&F)"
m_save m_save
m_reset m_reset
m_exit m_exit
end type
on m_file.create
this.m_save=create m_save
this.m_reset=create m_reset
this.m_exit=create m_exit
this.Item[]={this.m_save,this.m_reset,this.m_exit}
end on
on m_file.destroy
destroy(this.m_save)
destroy(this.m_reset)
destroy(this.m_exit)
end on
type m_save from menu within m_file
string text = "保存(&S)"
end type
event m_save.clicked;
w_main.of_menu("文件 > 保存")
w_main.tab_main.tabpage_form.of_save()
end event
type m_reset from menu within m_file
string text = "重置表单"
end type
event m_reset.clicked;
w_main.tab_main.tabpage_form.of_reset()
w_main.of_menu("文件 > 重置表单")
end event
type m_exit from menu within m_file
string text = "退出(&X)"
end type
event m_exit.clicked;
close(w_main)
end event
type m_edit from menu within m_main
string text = "编辑(&E)"
m_name m_name
m_about m_about
end type
on m_edit.create
this.m_name=create m_name
this.m_about=create m_about
this.Item[]={this.m_name,this.m_about}
end on
on m_edit.destroy
destroy(this.m_name)
destroy(this.m_about)
end on
type m_name from menu within m_edit
string text = "聚焦姓名"
end type
event m_name.clicked;
w_main.tab_main.SelectTab(1)
w_main.tab_main.tabpage_form.sle_name.SetFocus()
w_main.of_menu("编辑 > 聚焦姓名")
end event
type m_about from menu within m_edit
string text = "关于靶场"
end type
event m_about.clicked;
w_main.of_menu("编辑 > 关于靶场")
MessageBox("关于", "PowerBuilder 原生靶场：表单、DataWindow 和拖拽。")
end event
